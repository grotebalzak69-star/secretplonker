# 1. Alleen hier vul je de naam in
$bestandsnaam = "test.txt"

# 2. De server URL
$url = "http://192.168.1.XX:5000/upload" 

# 3. Zoek het bestand in je gebruikersmap
# Get-ChildItem = Zoeken
# -Recurse = Zoek ook in alle submappen
# -Filter = Zoek naar de naam
# -ErrorAction SilentlyContinue = Negeer fouten als het script geen toegang heeft tot een map
$gevondenBestand = Get-ChildItem -Path $env:USERPROFILE -Filter $bestandsnaam -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1

if ($gevondenBestand) {
    Write-Host "Bestand gevonden: $($gevondenBestand.FullName)"
    
    # 4. Verstuur het bestand
    $form = @{
        file = Get-Item $gevondenBestand.FullName
    }
    Invoke-RestMethod -Uri $url -Method Post -Form $form
    Write-Host "Upload succesvol!"
} else {
    Write-Host "Bestand '$bestandsnaam' niet gevonden in $env:USERPROFILE"
}